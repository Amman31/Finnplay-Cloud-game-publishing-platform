# Required for SQL (dashboard, trending, recommendations). Must match server Prisma DB.
# If this file is missing, the app also loads ../server/.env (non-overriding) so one copy of POSTGRESQL_URL is enough.
# You can use the same Prisma URL including ?schema=public — psycopg strips the schema= query param at connect time.
POSTGRESQL_URL=postgresql://finnplay:finnplay_dev_password@localhost:5433/finnplay?schema=public
