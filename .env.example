# =============================================================================
# Swarm / production-style deploy (see infra/swarm/stack.yml, Azure docs).
# Replace every "change-me" before real production. Do not commit a real .env.
# =============================================================================
#
# For Prisma + Node on your laptop against Docker Postgres only, use
# server/.env from server/.env.example (localhost + same password as dev compose).
#
# Hostname in POSTGRESQL_URL:
#   postgres  — API container on the same Docker network as the DB (Swarm / full compose).
#   localhost — API runs on your host; DB must publish 5432 (docker-compose.dev.yml).
#
# Blob container name is the same in every environment: finnplay-images (app setting).
# =============================================================================

REGISTRY_PREFIX=ghcr.io/your-github-username
IMAGE_TAG=latest

# Production (Azure): APP_HOST and API_HOST must be different hostnames (Traefik Host() rules).
# Web at apex:   APP_HOST=finnplay.xyz       API_HOST=api.finnplay.xyz
# Web subdomain: APP_HOST=app.finnplay.xyz  API_HOST=api.finnplay.xyz
# Never set both to finnplay.xyz — TLS / routing will break (ERR_CERT_AUTHORITY_INVALID).
# GRAFANA_HOST=grafana.finnplay.xyz
# PROMETHEUS_HOST=prometheus.finnplay.xyz
# PORTAINER_HOST=portainer.finnplay.xyz
# TRAEFIK_DASHBOARD_HOST=traefik.finnplay.xyz

APP_HOST=app.yourdomain.com
API_HOST=api.yourdomain.com
GRAFANA_HOST=grafana.yourdomain.com
PROMETHEUS_HOST=prometheus.yourdomain.com
PORTAINER_HOST=portainer.yourdomain.com
TRAEFIK_DASHBOARD_HOST=traefik.yourdomain.com
TRAEFIK_ACME_EMAIL=your-email@example.com

POSTGRES_DB=finnplay
POSTGRES_USER=finnplay
POSTGRES_PASSWORD=change-me
POSTGRESQL_URL=postgresql://finnplay:change-me@postgres:5432/finnplay?schema=public
# Used by Prisma (Node) and by python-service (FastAPI). The Python app strips ?schema=... for psycopg.

JWT_SECRET=change-me-to-long-random-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=finnplay-images
# Local Swarm + Azurite: BlobEndpoint often uses http://azurite:10000 (browser cannot resolve "azurite"). Set a host-reachable origin:
# AZURE_STORAGE_PUBLIC_ORIGIN=http://127.0.0.1:10000

# Server → FastAPI (admin dashboard / revenue / trending). In Swarm (stack.yml / stack.local.yml) the server gets:
#   PYTHON_SERVICE_URL=http://python-service:8000
# You do not need to set PYTHON_SERVICE_URL in .env unless you override stack behavior.

# --- Optional: local Swarm (stack.local.yml) extras ---
# NEXT_PUBLIC_API_URL=http://api.localhost/api
# FRONTEND_URL=http://app.localhost
# APP_HOST=app.localhost
# API_HOST=api.localhost
# GRAFANA_HOST=grafana.localhost
# PROMETHEUS_HOST=prometheus.localhost
# PORTAINER_HOST=portainer.localhost
# TRAEFIK_DASHBOARD_HOST=traefik.localhost
# Azurite from inside the stack (see docs/deployment-local.md for full connection string).
