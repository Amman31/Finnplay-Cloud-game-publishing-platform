// Prisma schema for PostgreSQL (FinnPlay)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("user") // 'user' or 'admin'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games      Game[]       @relation("GamePublisher")
  purchases  Purchase[]
  ratings    Rating[]
  ads        Ad[]
  sessions   Session[]
  analytics  Analytics[]

  @@map("users")
}

model Game {
  id                 String    @id @default(uuid())
  title              String
  description        String    @db.Text
  category           String
  imageUrl           String
  gameUrl            String
  published          Boolean   @default(false)
  publishedBy        String
  publishedAt        DateTime?
  price              Float     @default(0)
  tags               String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  publisher    User         @relation("GamePublisher", fields: [publishedBy], references: [id], onDelete: Cascade)
  purchases    Purchase[]
  ratings      Rating[]
  analytics    Analytics[]

  @@map("games")
}

model Purchase {
  id            String   @id @default(uuid())
  userId        String
  gameId        String
  amount        Float
  currency      String   @default("EUR")
  transactionId String   @unique
  paymentMethod String   @default("card")
  status        String   @default("completed") // 'completed' | 'pending' | 'failed'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("purchases")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  rating    Int      // 1-5
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("ratings")
}

model Ad {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  imageUrl        String
  linkUrl         String
  active          Boolean  @default(true)
  position        String   // 'banner' | 'sidebar' | 'popup' | 'in-game'
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  startDate       DateTime @default(now())
  endDate         DateTime?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("ads")
}

model Analytics {
  id        String   @id @default(uuid())
  gameId    String
  eventType String
  userId    String?
  metadata  Json     @default("{}")
  ipAddress String?
  userAgent String?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([eventType])
  @@index([timestamp])
  @@map("analytics")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
