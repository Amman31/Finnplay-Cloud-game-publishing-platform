# Local Node/Prisma on your machine. Password must match infra/local/docker-compose.dev.yml (POSTGRES_PASSWORD).
# Use localhost and port 5433 (mapped in that compose file) so you do not collide with a local Postgres on 5432.

PORT=5000
# Prisma accepts ?schema=public. python-service strips schema= for psycopg when using the same URL (via server/.env load).
POSTGRESQL_URL=postgresql://finnplay:finnplay_dev_password@localhost:5433/finnplay?schema=public
JWT_SECRET=change-me-to-long-random-secret
# Must match how you open the Next app (localhost vs 127.0.0.1). In dev, both are allowed by CORS.
FRONTEND_URL=http://localhost:3000
# Local FastAPI (required for admin aggregate analytics: dashboard, revenue, trending).
PYTHON_SERVICE_URL=http://localhost:8000
# Azurite (Docker service "azurite" / container finnplay-azurite-dev) emulates Azure Blob Storage on port 10000.
# AZURE_STORAGE_CONTAINER_NAME is a *blob* container name inside that account (like a bucket folder), not the Docker container name.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=finnplay-images
# If BlobEndpoint uses http://azurite:10000, set a browser-reachable origin for URLs returned by the API (optional).
# AZURE_STORAGE_PUBLIC_ORIGIN=http://127.0.0.1:10000

# First admin (run once after migrate: repo root `npm run dev:create-admin`, or `cd server && npm run create-admin`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=choose-a-strong-password
